--- !u!114 &1993202843360704150
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5467969182054369834}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 0, g: 1, b: 0.5019608, a: 1}
  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: d8a7948bc83b01f45ab5078c10dd8e04, type: 3}
    m_FontSize: 80
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 0
    m_MaxSize: 118
    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\r\nNeed to hit the ball with the smallest number.\r\n\r\nCall shots are
    required except for break shots.\r\n\r\nIf the call shot is successful, the other
    balls pocketed on that shot will also be awarded points.\r\n\r\nAfter a foul,
    you can choose the position of the cue ball and the target ball. (Not a free
    ball)\r\n\r\nWhen a cue ball is selected, it is a free ball in the kitchen (if
    there is a target ball in the kitchen at that time, it will be moved).\r\n\r\n\r\n\r\nAn
    invalid ball that is pocketed after a failed call shot returns to the foot.\r\n\r\nThe
    final shot of the rack brings the cue ball back into the kitchen and the next
    break can be made from that position.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nIf you didn't
    pocket on the break shot, you must have 4 or more target balls hit the cushion
    or you will get a breaking foul.\r\n\r\nAfter a breaking foul, you can request
    a re-break. Or you can break it yourself.\r\n\r\nNone of the cueballs or target
    balls hit the cushion after the cueball hit the target ball. (no cushion foul)\r\n\r\nThe
    cueball didn't hit the target ball. (no hit)\r\n\r\nIf the cue ball is pocketed,
    the call shot is a foul even if successful. (scratch)\r"
