    m_Alignment: 1
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\r\n\u3069\u306E\u7684\u7403\u304B\u3089\u30DD\u30B1\u30C3\u30C8\u3057\u3066\u3082\u69CB\u3044\u307E\u305B\u3093\u3002(any
    ball)\r\n\r\n\u30DD\u30B1\u30C3\u30C8\u3057\u305F\u30DC\u30FC\u30EB\u306E\u756A\u53F7\u304C\u70B9\u6570\u306B\u306A\u308A\u307E\u3059\u3002\r\n\r\n\u30B5\u30A4\u30C9\u30DD\u30B1\u30C3\u30C8\u306B\u843D\u3068\u3057\u305F\u5834\u5408\u306F\u500D\u306E\u70B9\u6570\u304C\u5165\u308A\u307E\u3059\u3002\r\n\r\n\u30DD\u30B1\u30C3\u30C8\u3067\u304D\u306A\u304B\u3063\u305F\u5834\u5408\u306F\u76F8\u624B\u30C1\u30FC\u30E0\u306B\u30BF\u30FC\u30F3\uFF08\u30B7\u30E7\u30C3\u30C8\u9806\u756A\uFF09\u304C\u6E21\u308A\u307E\u3059\r\u3002\n\r\n\u624B\u7403\u304C\u3069\u306E\u7684\u7403\u306B\u3082\u5F53\u305F\u3089\u306A\u304B\u3063\u305F\u5834\u5408\u306F\u30D5\u30A1\u30A6\u30EB\u3067\u3059\u3002\r\n\r\n\u624B\u7403\u304C\u30DD\u30B1\u30C3\u30C8\u3084\u5834\u5916\u306B\u843D\u3061\u308B\u3068\u30D5\u30A1\u30A6\u30EB\u3067\u3059\u3002\r\n\r\n\u30D5\u30A1\u30A6\u30EB\u3059\u308B\u3068\u70B9\u6570\u306F\u5165\u308A\u307E\u305B\u3093\u3002\uFF080\u70B9\uFF09\r\n\r\n\u30D5\u30A1\u30A6\u30EB\u3059\u308B\u3068\u76F8\u624B\u30C1\u30FC\u30E0\u306B\u30D5\u30EA\u30FC\u30DC\u30FC\u30EB\u3067\u30BF\u30FC\u30F3\u304C\u6E21\u308A\u307E\u3059\u3002\r\n\r\n\u7684\u7403\u3092\u5168\u3066\u843D\u3068\u3057\u305F\u3089\u70B9\u6570\u306E\u591A\u3044\u30C1\u30FC\u30E0\u304C\u52DD\u8005\u3067\u3059\u3002\r\n\r\n\u6700\u7D42\u30B7\u30E7\u30C3\u30C8\u306F\u500D\u306E\u70B9\u6570\u304C\u5165\u308A\u307E\u3059\u3002\r\n\r\n\u540C\u70B9\u3060\u3063\u305F\u5834\u5408\u306F\u6700\u5F8C\u306E\u30DC\u30FC\u30EB\u3092\u30D5\u30A1\u30A6\u30EB\u305B\u305A\u306B\u843D\u3068\u3057\u305F\u30C1\u30FC\u30E0\u304C\u52DD\u8005\u3067\u3059\u3002\r\n\r\n\u540C\u70B9\u3060\u3063\u305F\u5834\u5408\u306B\u6700\u5F8C\u306E\u30DC\u30FC\u30EB\u3092\u30D5\u30A1\u30A6\u30EB\u3057\u3066\u843D\u3068\u3057\u3066\u3044\u305F\u3089\u8CA0\u3051\u3067\u3059\u3002\r\n\r\n\u30B2\u30FC\u30E0\u4E2D\u306B\u30C1\u30FC\u30E0\u30E1\u30F3\u30D0\u30FC\u3092\u5909\u66F4\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\r\n\r\n\u30C1\u30FC\u30E0\u30E1\u30F3\u30D0\u30FC\u3092\u5909\u66F4\u3059\u308B\u3068\u30D7\u30EC\u30A4\u30E4\u30FC\u500B\u4EBA\u306E\u30B9\u30B3\u30A2\u306F\u30EA\u30BB\u30C3\u30C8\u3055\u308C\u307E\u3059\u3002\r\n\r\n\u30D7\u30EC\u30A4\u30E4\u30FC\u304C\u30AA\u30EC\u30F3\u30B8\u30C1\u30FC\u30E0\u306E\u307F\u306B\u306A\u308B\u3068\u7DF4\u7FD2\u30E2\u30FC\u30C9\u306B\u306A\u308A\u307E\u3059\u3002"
